    <main id="main-content" class="main" role="main">
        <!-- Dashboard Stats -->
        <section class="dashboard-stats">
            <div class="container">
                <div class="stats-grid">
                    <div class="stat-card">
                        <div class="stat-icon pending">
                            <i class="fas fa-clock"></i>
                        </div>
                        <div class="stat-content">
                            <h3 id="pendingCount">0</h3>
                            <p>Pending Cases</p>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon active">
                            <i class="fas fa-folder-open"></i>
                        </div>
                        <div class="stat-content">
                            <h3 id="activeCount">0</h3>
                            <p>Active Cases</p>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon completed">
                            <i class="fas fa-check-circle"></i>
                        </div>
                        <div class="stat-content">
                            <h3 id="completedCount">0</h3>
                            <p>Completed Cases</p>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon total">
                            <i class="fas fa-list"></i>
                        </div>
                        <div class="stat-content">
                            <h3 id="totalCount">0</h3>
                            <p>Total Cases</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Filters and Search -->
        <section class="dashboard-controls">
            <div class="container">
                <div class="controls-container">
                    <div class="search-box">
                        <i class="fas fa-search"></i>
                        <input type="text" id="searchInput" placeholder="Search cases by name, case number, or type...">
                    </div>
                    <div class="filter-group">
                        <select id="statusFilter">
                            <option value="">All Statuses</option>
                            <option value="pending">Pending</option>
                            <option value="active">Active</option>
                            <option value="on-hold">On Hold</option>
                            <option value="completed">Completed</option>
                            <option value="closed">Closed</option>
                        </select>
                        <select id="typeFilter">
                            <option value="">All Types</option>
                            <option value="family-law">Family Law</option>
                            <option value="criminal-defense">Criminal Defense</option>
                            <option value="personal-injury">Personal Injury</option>
                            <option value="employment">Employment Law</option>
                            <option value="immigration">Immigration</option>
                            <option value="housing">Housing</option>
                            <option value="estate-planning">Estate Planning</option>
                            <option value="business">Business Law</option>
                            <option value="other">Other</option>
                        </select>
                        <select id="urgencyFilter">
                            <option value="">All Urgency Levels</option>
                            <option value="emergency">Emergency</option>
                            <option value="urgent">Urgent</option>
                            <option value="normal">Normal</option>
                            <option value="low">Low Priority</option>
                        </select>
                        <button class="btn-secondary" id="clearFiltersBtn">
                            <i class="fas fa-times"></i>
                            Clear Filters
                        </button>
                    </div>
                </div>
            </div>
        </section>

        <!-- Cases List -->
        <section class="cases-section">
            <div class="container">
                <div class="cases-header">
                    <h2>Cases</h2>
                    <div class="view-toggle">
                        <button class="view-btn active" data-view="list" title="List View">
                            <i class="fas fa-list"></i>
                        </button>
                        <button class="view-btn" data-view="grid" title="Grid View">
                            <i class="fas fa-th"></i>
                        </button>
                    </div>
                </div>
                <div id="casesContainer" class="cases-container">
                    <!-- Cases will be populated by JavaScript -->
                </div>
                <div id="emptyState" class="empty-state" style="display: none;">
                    <i class="fas fa-inbox"></i>
                    <h4>No cases found</h4>
                    <p>No cases match your current filters. Try adjusting your search criteria.</p>
                </div>
            </div>
        </section>
    </main>

    <!-- Case Detail Modal -->
    <div id="caseModal" class="modal" style="display: none;">
        <div class="modal-content modal-large">
            <div class="modal-header">
                <h3 id="modalCaseTitle">Case Details</h3>
                <button class="modal-close" onclick="closeCaseModal()">&times;</button>
            </div>
            <div class="modal-body" id="modalCaseBody">
                <!-- Case details will be populated by JavaScript -->
            </div>
            <div class="modal-footer">
                <button class="btn-secondary" onclick="closeCaseModal()">Close</button>
                <button class="btn-primary" id="updateCaseBtn">
                    <i class="fas fa-save"></i>
                    Update Case
                </button>
            </div>
        </div>
    </div>

    <!-- Update Case Status Modal -->
    <div id="updateStatusModal" class="modal" style="display: none;">
        <div class="modal-content">
            <div class="modal-header">
                <h3>Update Case Status</h3>
                <button class="modal-close" onclick="closeUpdateStatusModal()">&times;</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label for="newStatus">New Status *</label>
                    <select id="newStatus" required>
                        <option value="pending">Pending</option>
                        <option value="active">Active</option>
                        <option value="on-hold">On Hold</option>
